# The environment only configures how the HTTP server binds.
# All printer and label settings are stored in SQLite (./data/settings.db)
# and managed at runtime through the settings API / web UI.

# Port the HTTP API + frontend are served on
PORT=8080
# Host to bind. 0.0.0.0 = all interfaces (needed in Docker); 127.0.0.1 = local only
HOST=0.0.0.0
